{
  "name": "@intl-tms/core",
  "version": "0.1.0",
  "description": "Core of an in-context translation management system: marker codec, catalog marking, request handler, page-side editing flow and panel state machine.",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/website.d.ts",
      "default": "./dist/website.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/lint.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
